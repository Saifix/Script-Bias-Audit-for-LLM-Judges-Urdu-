# Copy to .env and fill in (or run:  sh scripts/init-env.sh  to generate the secrets).
# Everything here stays on the server. The browser never sees any of it.

# --- OpenRouter (used only by the backend container)
OPENROUTER_API_KEY=

# --- Login: comma-separated user:password pairs (passwords must be 12+ characters)
APP_USERS=admin:change-me-to-a-long-password
# Signs login cookies. 32+ random characters. Changing it signs everyone out.
SESSION_SECRET=
# Shared secret between the frontend proxy and the backend. 32+ random characters.
BACKEND_TOKEN=

# --- Network
FRONTEND_PORT=3000
FRONTEND_BIND=0.0.0.0
# HTTPS: uncomment these three, point the domain's DNS at the server, open ports 80 + 443.
# COMPOSE_PROFILES=https
# DOMAIN=audit.example.com
# FRONTEND_BIND=127.0.0.1
# Send cookies over HTTPS only (set automatically behind Caddy; force it here if you use another TLS proxy).
COOKIE_SECURE=false

# --- Optional
HF_TOKEN=
